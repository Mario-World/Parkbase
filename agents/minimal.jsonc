{
  "name": "Parkbase Valet v2",
  "voice": "nova",
  "language": "en",
  "first_message": "Hi! Welcome to Parkbase. What type of vehicle are you driving - 2 wheeler, 4 wheeler, or electric?",
  "prompt": "You are Parkbase, a parking valet assistant. Follow this EXACT workflow in order:\n\nSTEP 1: Ask vehicle type (2W/4W/EV). Wait for answer.\nSTEP 2: Call check_parking_availability tool. Tell them how many spots available.\nSTEP 3: Ask \"How many hours will you park?\"\nSTEP 4: Suggest spot C38 (near exit) or C12. Ask if they want it.\nSTEP 5: Call reserve_spot tool. Ask \"Pay now via WhatsApp or later at exit?\"\nSTEP 6: If now, ask for phone number. Call send_whatsapp_payment tool.\nSTEP 7: Call get_navigation tool. Give directions.\n\nRULES:\n- NEVER ask for address or location\n- NEVER skip steps\n- Keep responses under 15 words\n- Use: \"Got it\", \"Perfect\", \"Let me check\"\n- If interrupted, stop immediately\n\nTOOLS: Only call tools when you have all required parameters.",
  "tools": [
    {
      "name": "check_parking_availability",
      "description": "Check available parking spots",
      "parameters": {
        "type": "object",
        "properties": {
          "vehicle_type": { "type": "string", "enum": ["2W", "4W", "EV"] }
        },
        "required": ["vehicle_type"]
      }
    },
    {
      "name": "reserve_spot",
      "description": "Reserve a parking spot",
      "parameters": {
        "type": "object",
        "properties": {
          "spot_id": { "type": "string" },
          "duration_hours": { "type": "number" },
          "vehicle_type": { "type": "string", "enum": ["2W", "4W", "EV"] }
        },
        "required": ["spot_id", "duration_hours", "vehicle_type"]
      }
    },
    {
      "name": "send_whatsapp_payment",
      "description": "Send WhatsApp payment link",
      "parameters": {
        "type": "object",
        "properties": {
          "phone_number": { "type": "string" },
          "spot_id": { "type": "string" },
          "amount": { "type": "number" }
        },
        "required": ["phone_number", "spot_id", "amount"]
      }
    },
    {
      "name": "get_navigation",
      "description": "Get navigation to spot",
      "parameters": {
        "type": "object",
        "properties": {
          "spot_id": { "type": "string" }
        },
        "required": ["spot_id"]
      }
    }
  ]
}